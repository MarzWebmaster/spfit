# SPFIT Environment Variables Example
# Copy to .env and fill in your actual values
# For production, use .env.production instead

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=spfit_db
DB_USER=root
DB_PASSWORD=

# ==============================================================================
# JWT CONFIGURATION
# ==============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
PORT=3005
SERVER_HOST=localhost
NODE_ENV=development

# ==============================================================================
# FILE UPLOAD CONFIGURATION
# ==============================================================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ==============================================================================
# FRONTEND CONFIGURATION
# ==============================================================================
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3005/api

# ==============================================================================
# EMAIL CONFIGURATION (SMTP)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@spfit.com

# ==============================================================================
# SECURITY CONFIGURATION
# ==============================================================================
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT=100
ENCRYPTION_KEY=fc5c96a1cb06b7bd3a21aa94fadf65cfa8a218ffd184ac85fbc821b7aa5e07fe

# ==============================================================================
# BACKUP CONFIGURATION - IMPORTANT!
# ==============================================================================
# Use ABSOLUTE path based on your operating system:
# 
# LOCAL DEVELOPMENT (Windows):
#   BACKUP_PATH=D:\SPFIT_Backups
#   BACKUP_PATH=C:\Projects\SPFIT_Backups
#
# LOCAL DEVELOPMENT (macOS/Linux):
#   BACKUP_PATH=/Users/username/spfit_backups
#   BACKUP_PATH=/home/username/spfit_backups
#
# PRODUCTION (Linux VPS/Server):
#   BACKUP_PATH=/home/username/app/backups
#   BACKUP_PATH=/var/www/spfit/backups
#   BACKUP_PATH=/opt/spfit/backups
#
# PRODUCTION (Windows Server):
#   BACKUP_PATH=E:\backups
#   BACKUP_PATH=D:\app\spfit\backups
#
BACKUP_PATH=D:\SPFIT_Backups

# ==============================================================================
# GITHUB CONFIGURATION
# ==============================================================================
# Generate Personal Access Token at: https://github.com/settings/tokens
# Required scopes: repo (full control of private repositories)
# Store safely and NEVER commit to git!
GITHUB_TOKEN=ghp_your_token_here

# ==============================================================================
# ADDITIONAL NOTES
# ==============================================================================
# - .env file is NOT committed to git (see .gitignore)
# - API endpoints: GET /api/system/backups (list) and /api/system/backups/download/:fileName
# - Only users with 'system.admin' permission can access backup endpoints
# - All backup downloads are logged in activity logs for audit trail
# - Backup directory is auto-created if it doesn't exist
